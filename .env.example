# MFH Studio / Portfolio SaaS — environment example
# Copy to .env or use Admin → Site Settings → Platform AI Brain (recommended).
# Never commit real secrets.

FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=0

# Main AI brain: openai | gemini | claude
AI_BRAIN_PROVIDER=openai

# ChatGPT / OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Claude (Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest

# Optional email delivery
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
